{
  "name": "meowconvert",
  "version": "1.1.0",
  "description": "MeowConvert — private, offline file converter for Windows",
  "main": "electron/main.mjs",
  "author": "AminMGM",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "test:engines": "node scripts/test-engines.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "vite build && electron-builder --win nsis",
    "dist:publish": "vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "fonteditor-core": "^2.6.3",
    "heic-decode": "^2.1.0",
    "html-to-docx": "^1.8.0",
    "imagetracerjs": "^1.2.6",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.3.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.12",
    "pdfjs-dist": "^6.5.438",
    "three": "^0.187.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.aminmgm.meowconvert",
    "productName": "MeowConvert",
    "copyright": "Made with <3 by AminMGM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/7zip-bin/{mac,linux}/**",
      "!node_modules/7zip-bin/win/{ia32,arm64}/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/7zip-bin/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/fonteditor-core/**",
      "electron/engines/font-worker.cjs",
      "node_modules/@xmldom/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AminMGM",
        "repo": "MeowConvert",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/AminMGM/MeowConvert",
  "repository": {
    "type": "git",
    "url": "https://github.com/AminMGM/MeowConvert.git"
  }
}
